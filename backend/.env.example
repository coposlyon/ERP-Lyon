# ============================================================
# TODAS AS VARIÁVEIS QUE O ERP LÊ — nomes, sem valores.
#
# Este arquivo existe porque o servidor do Discloud foi apagado uma vez
# e ninguém tinha a lista do que estava configurado lá. Quem for subir o
# ERP em outro lugar copia isto para backend/.env e preenche.
#
# Os valores de verdade ficam no backend/.env (fora do git) e num
# gerenciador de senhas. NUNCA neste arquivo.
# ============================================================


# ── OBRIGATÓRIAS — sem estas o servidor não sobe ou o ERP não funciona
PORT=3001
NODE_ENV=production                 # 'development' na máquina local

# Supabase (Configurações do projeto → API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=                  # a chave "anon" — confirma a senha da fábrica
SUPABASE_SERVICE_KEY=               # a chave "service_role" — o servidor inteiro usa esta

# Conexão direta ao Postgres (Configurações → Database → Connection string, modo "URI").
# As migrations rodam por aqui na subida do servidor. Sem ela, o schema fica parado.
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# O endereço do site — CORS e os links que saem por e-mail e WhatsApp.
FRONTEND_URL=https://lyoncopos.online

# IA (copiloto, leitura de comprovante) — console.groq.com
GROQ_API_KEY=


# ── GOOGLE CONTATOS — o cliente cadastrado vira contato no celular do dono
# Console: console.cloud.google.com → APIs e serviços → Credenciais → cliente OAuth 2.0.
# O refresh token NÃO se recupera: gere com `node backend/scripts/google-token.js`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=


# ── OPCIONAIS — cada bloco liga uma função; ausente, ela fica desligada sem quebrar nada

# Segredo dos links do portal do cliente. Se ausente, usa SUPABASE_SERVICE_KEY.
# (Trocar invalida os links já enviados.)
PEDIDO_TOKEN_SECRET=
JWT_SECRET=

# WhatsApp Cloud API (Meta) — envio AUTOMÁTICO. Sem isto, o sistema monta a
# mensagem e abre a conversa para a pessoa apertar enviar.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Claude (Anthropic) — OCR do comprovante
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_OCR=

# E-mail (Resend) — convites de RH, avisos
RESEND_API_KEY=
MAIL_FROM=

# Monitoramento de erros
SENTRY_DSN=

# Pix estático — o sistema lê PRIMEIRO de EMPRESAS.settings.pix (tela de
# Configurações); estas só valem como fallback.
PIX_KEY=
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=

# Mercado Pago — recusado por decisão da Lyon (taxa). Fica aqui só por existir no código.
MP_ACCESS_TOKEN=
MP_WEBHOOK_URL=

# Transportadoras — Braspress e Total Express leem de EMPRESAS.settings.frete
# (tela de Configurações). Estas são fallback.
BRASPRESS_USER=
BRASPRESS_PASSWORD=
BRASPRESS_CNPJ=
BRASPRESS_CNPJ_DEST=
BRASPRESS_BASE_URL=
BRASPRESS_MODAL=
BRASPRESS_TIPO_FRETE=
TOTALEXPRESS_WS_URL=
TOTALEXPRESS_WS_USER=
TOTALEXPRESS_WS_PASSWORD=
TOTALEXPRESS_REID=
TOTALEXPRESS_RASTREIO_AUTOMATICO=
MELHORENVIO_TOKEN=
MELHORENVIO_BASE=

# Consulta de crédito
CREDIT_PROVIDER=
CREDIT_API_URL=
CREDIT_API_KEY=

# Marketing (Instagram / Facebook)
FB_PAGE_TOKEN=
FB_PAGE_ID=
IG_USER_ID=
META_GRAPH_BASE=

# Ajustes finos — todos têm padrão embutido no código
APP_URL=                            # base pública da API; padrão = FRONTEND_URL
STORE_TENANT_ID=                    # empresa da loja pública; padrão = Lyon
PUBLIC_STORAGE_BUCKET=loja-publico
PRIVATE_STORAGE_BUCKET=DOCUMENTOS
AUTO_MIGRATE=true                   # 'false' desliga as migrations na subida
MIGRATE_BOOT_TIMEOUT_MS=
STORE_PIX_VALIDADE_H=
CATALOGO_VALIDADE_DIAS=
CATALOGO_PRAZO_MIN=
CATALOGO_PRAZO_MAX=
GROQ_MODEL=
