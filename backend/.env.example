PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-jwt-secret-here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# J&T Express (opcional — também pode ser configurado em Configurações → Transportadora)
# Homologação: https://demoopenapi.jtjms-br.com | Produção: https://openapi.jtjms-br.com
JT_BASE_URL=
JT_CUSTOMER_CODE=
JT_PASSWORD=
JT_API_ACCOUNT=
JT_PRIVATE_KEY=
